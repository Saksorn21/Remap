entrypoint = "src/App.tsx"
modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]

[[workflows.workflow]]
name = "run dev"
mode = "sequential"
author = 34106712

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "Start"
mode = "parallel"
author = 34106712

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "run dev"

[[workflows.workflow]]
name = "Hi"
mode = "sequential"
author = 34106712

[[workflows.workflow.tasks]]
task = "shell.exec"
args = '''npm install --save-dev husky lint-staged npx husky init node --eval "fs.writeFileSync('.husky/pre-commit','npx lint-staged\n')"'''

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5173
externalPort = 80
